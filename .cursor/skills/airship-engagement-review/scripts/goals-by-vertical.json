  "verticals": {
    "all verticals": {
      "label": "All verticals",
      "key": "all_verticals",
      "businessModel": "service_account",
      "conversionMeaning": "the single act the brand is judged on — confirm it with the client before configuring anything",
      "funnel": {
        "acquisition": [
          "channel_registration"
        ],
        "activation": [
          "registered_account",
          "logged_in",
          "notification_opt_in",
          "named_user_association"
        ],
        "consideration": [
          "browsed",
          "search",
          "added_to_cart"
        ],
        "conversion": [
          "purchased",
          "consumed_content"
        ],
        "loyalty": [
          "starred_content",
          "shared_content"
        ],
        "retention": [
          "app_open",
          "logged_out"
        ]
      },
      "priorityArchetypes": [
        "purchased",
        "registered_account",
        "named_user_association",
        "app_open"
      ],
      "blindStagePitch": {
        "conversion": "No collected event marks the moment the business is paid. Every campaign report stops at opens.",
        "activation": "Nothing marks the transition from installed to signed-in, so onboarding cannot be measured or optimised."
      }
    },
    "Retail": {
      "label": "Retail",
      "key": "retail",
      "businessModel": "transactional",
      "conversionMeaning": "a paid order, in-app or click-and-collect, with its amount",
      "funnel": {
        "acquisition": [
          "channel_registration"
        ],
        "activation": [
          "registered_account",
          "logged_in",
          "named_user_association",
          "notification_opt_in"
        ],
        "consideration": [
          "browsed",
          "search",
          "add_to_wishlist",
          "added_to_cart"
