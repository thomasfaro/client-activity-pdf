  "businessModels": [
    {
      "id": "transactional",
      "label": "Transactional",
      "description": "Revenue lands on a discrete purchase, order or booking.",
      "conversionMeaning": "a completed, paid transaction",
      "defaultPeriod": "weekly",
      "boostStages": {
        "conversion": 1.25,
        "consideration": 1.1,
        "loyalty": 1.0
      },
      "requiresMonetaryValue": true,
      "northStarPreference": [
        "purchased",
        "added_to_cart"
      ]
    },
    {
      "id": "subscription",
      "label": "Subscription",
      "description": "Revenue is recurring; the fight is activation then churn, not the single sale.",
      "conversionMeaning": "a started, renewed or retained subscription",
      "defaultPeriod": "monthly",
      "boostStages": {
        "conversion": 1.2,
        "retention": 1.25,
        "activation": 1.15
      },
      "requiresMonetaryValue": true,
      "northStarPreference": [
        "purchased",
        "consumed_content"
      ]
    },
    {
      "id": "ad_funded",
      "label": "Ad-funded",
      "description": "Revenue follows attention: sessions, content consumed, inventory served.",
      "conversionMeaning": "depth of consumption, not a payment",
      "defaultPeriod": "daily",
      "boostStages": {
        "conversion": 1.15,
        "retention": 1.3,
        "loyalty": 1.1
      },
      "requiresMonetaryValue": false,
      "northStarPreference": [
        "consumed_content",
        "app_open",
        "browsed_content"
      ]
    },
    {
      "id": "service_account",
      "label": "Service / account management",
      "description": "The app services an existing contract; success is self-service completion and reachability, not a sale.",
      "conversionMeaning": "a self-service task completed in the app instead of in a call centre",
      "defaultPeriod": "monthly",
      "boostStages": {
        "activation": 1.3,
        "retention": 1.2,
        "conversion": 1.0
      },
      "requiresMonetaryValue": false,
      "northStarPreference": [
        "named_user_association",
        "registered_account",
        "app_open"
      ]
    },
    {
      "id": "marketplace",
      "label": "Marketplace",
      "description": "Two-sided; the platform is paid on matched transactions.",
      "conversionMeaning": "a completed match or booking between the two sides",
      "defaultPeriod": "weekly",
      "boostStages": {
        "conversion": 1.25,
        "consideration": 1.15
      },
      "requiresMonetaryValue": true,
      "northStarPreference": [
        "purchased",
        "search"
      ]
    }
