        "conversion": [
          "purchased"
        ],
        "loyalty": [
          "starred_product",
          "shared_product"
        ],
        "retention": [
          "app_open"
        ]
      },
      "priorityArchetypes": [
        "purchased",
        "added_to_cart",
        "registered_account",
        "browsed"
      ],
      "valueCritical": [
        "purchased",
        "added_to_cart"
      ],
      "blindStagePitch": {
        "conversion": "Purchase is not tracked, so no campaign can be credited with revenue — the account is measured on opens while the business is measured on baskets.",
        "consideration": "Cart and wishlist are not tracked, which removes abandonment recovery, the single highest-ROI retail journey."
      },
      "roadmapHints": [
        {
          "archetype": "purchased",
          "why": "revenue attribution on every message and Scene",
          "properties": [
            "value",
            "currency",
            "category",
            "quantity"
          ]
        },
        {
          "archetype": "added_to_cart",
          "why": "unlocks cart-abandonment journeys and a consideration-stage goal",
          "properties": [
            "value",
            "currency",
            "id",
            "category"
          ]
        },
        {
          "archetype": "search",
          "why": "intent signal for restock and category-affinity messaging",
          "properties": [
            "query",
            "results"
          ]
        }
      ]
    },
